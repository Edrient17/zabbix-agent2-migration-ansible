[zabbix_agents]
server01 ansible_host=192.0.2.11 ansible_user=monitoring
server02 ansible_host=192.0.2.12 ansible_user=monitoring

[zabbix_agent2_pilot]
server01

# Docker 템플릿을 사용하는 호스트만 이 그룹에도 추가합니다.
[zabbix_agent2_docker]
server01

[zabbix_agent2_docker:vars]
zabbix_agent2_manage_docker_access=true

# 일반 사용자로 SSH 로그인한 후 "su - root" 방식으로 권한을 상승합니다.
[zabbix_agents:vars]
ansible_connection=ssh
ansible_become=true
ansible_become_method=su
ansible_become_user=root
ansible_become_flags=-
